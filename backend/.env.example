APP_ENV=development
DATABASE_URL=sqlite:///./vegz_agent.db
# Change to a unique random secret with at least 32 characters before any hosted use.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
AGENT_DEMO_CODE=123456
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Must match DISPATCH_SHARED_SECRET in vegz-user .env; use a random secret of at least 32 characters.
DISPATCH_SHARED_SECRET=replace-with-the-same-random-secret-used-by-vegz-user

# Admin approval integration. Use the same random token in all four apps.
ADMIN_SERVICE_URL=http://host.docker.internal:8000
USER_SERVICE_URL=http://host.docker.internal:8003
PARTNER_ADMIN_TOKEN=replace-with-a-random-shared-partner-token-at-least-32-chars
